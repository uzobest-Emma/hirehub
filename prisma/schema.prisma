generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model application {
  applicantId String?
  coverLetter String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  email       String
  fullName    String
  id          String   @id
  jobId       String
  location    String
  phone       String
  resumeUrl   String
  status      String   @default("Pending")
  user        user?    @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job         job      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([applicantId], map: "application_applicantId_idx_f3b3eac3")
  @@index([jobId], map: "application_jobId_idx_623c8f77")
}

model job {
  category         String
  company          String
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  description      String
  employerId       String?
  experience       String
  id               String        @id
  location         String
  requirements     String
  responsibilities String
  salary           String
  salaryNumber     Int
  title            String
  type             String
  application      application[]
  user             user?         @relation(fields: [employerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saved_job        saved_job[]

  @@index([employerId], map: "job_employerId_idx_599302e4")
}

model saved_job {
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  id        String   @id
  jobId     String
  userId    String
  job       job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, jobId])
  @@index([jobId], map: "saved_job_jobId_idx_623c8f77")
  @@index([userId], map: "saved_job_userId_idx_a489d58a")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user {
  bio         String?
  companyLogo String?
  companyName String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  email       String        @unique
  fullName    String?
  id          String        @id
  location    String?
  password    String
  phone       String?
  resumeUrl   String?
  role        String        @default("JOB_SEEKER")
  skills      String?
  website     String?
  application application[]
  job         job[]
  saved_job   saved_job[]
}
